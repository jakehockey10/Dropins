npm-debug.log

vendor/assets/components
public/uploads

.byebug_history

# Ignore application configuration
/config/application.yml

/config/secrets.yml
/config/database.yml

# Ignore test output
public/uploads/micropost/picture/

# ignore SimpleCov
coverage
