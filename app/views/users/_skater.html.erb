<tr>
  <td>
    <%= gravatar_for skater, size: 52 %>
    <%= link_to skater.name, skater %>
  </td>
  <td class="text-center">
    <%= skater.followers.count %>
  </td>
  <td class="text-center">
    <% if skater.active? %>
      <span class="glyphicon glyphicon-ok"></span>
    <% end %>
  </td>
  <td class="text-center">
    <!--add !current_user.nil? && to the predicate below so that
      attempting to reach the followers/following pages of a
      particular user while not signed in does not cause an error.
      If you are not signed in, current_user is nil and thus we
      cannot call the admin? method on that object at that time.-->
    <% if !current_user.nil? && current_user.admin? && !current_user?(skater) %>
      <%= link_to 'delete', skater, method: :delete, data: { confirm: 'You sure?  This will delete this user\'s account...' } %>
    <% end %>
  </td>
</tr>