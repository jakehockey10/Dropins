<tr>
  <td>
    <%= avatar_for skater, size: :small %>
    <%= link_to skater.name, skater %>
  </td>
  <td class="text-center">
    <%= skater.followers.count %>
  </td>
  <td class="text-center">
    <% if skater.active? %>
      <span class="glyphicon glyphicon-ok"></span>
    <% end %>
  </td>
  <td class="text-center">
    <% if Attendance.where(user_id: skater.id, dropin_id: @dropin.id).first.paid %>
      <span class="glyphicon glyphicon-ok"></span>
    <% end %>
  </td>
  <!--add !current_user.nil? && to the predicate below so that
      attempting to reach the followers/following pages of a
      particular user while not signed in does not cause an error.
      If you are not signed in, current_user is nil and thus we
      cannot call the admin? method on that object at that time.-->
  <% if !current_user.nil? && current_user.admin? && !Attendance.where(user_id: skater.id, dropin_id: @dropin.id).first.paid %>
    <td class="text-center">
      <%= bootstrap_form_for skater.attendances.find_by(dropin_id: @dropin.id), html: { method: :delete } do |f| %>
        <%= f.hidden_field :user_id, value: skater.id %>
        <%= f.submit 'Remove', class: 'btn btn-danger btn-sm', alert: 'Are you sure?', data: { disable_with: 'Removing...' } %>
      <% end %>
    </td>
  <% end %>
</tr>