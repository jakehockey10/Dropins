<tr>
  <td>
    <%= avatar_for skater, size: :small %>
    <%= link_to skater.name, skater %>
  </td>
  <td class="text-center" style="vertical-align: middle">
    <%= skater.followers.count %>
  </td>
  <td class="text-center" style="vertical-align: middle">
    <% if skater_has_paid(skater.id, @dropin.id) %>
      <%= fa_icon 'check 2x' %>
    <% end %>
  </td>
  <!--add !current_user.nil? && to the predicate below so that
      attempting to reach the followers/following pages of a
      particular user while not signed in does not cause an error.
      If you are not signed in, current_user is nil and thus we
      cannot call the admin? method on that object at that time.-->
  <% if show_remove_skater_from_dropin_button(skater.id, @dropin.id) %>
    <td class="text-center">
      <%= form_for skater.attendances.find_by(dropin_id: @dropin.id), html: { method: :delete }, remote: true do |f| %>
        <%= f.hidden_field :user_id, value: skater.id %>
        <%= f.button 'Remove',
                     class: 'btn btn-danger btn-sm',
                     alert: 'Are you sure?',
                     data: { disable_with: "#{fa_icon 'spinner pulse'} Removing..." } %>
      <% end %>
    </td>
  <% end %>
</tr>