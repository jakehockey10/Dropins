<%= bootstrap_form_for(current_user.relationships.find_by(followed_id: @user.id),
             html: { method: :delete },
             remote: true) do |f| %>
  <%= f.button 'Unfollow',
               class: 'btn btn-default btn-lg',
               data: { disable_with: "#{fa_icon 'spinner pulse'} Unfollowing..." } %>
<% end %>