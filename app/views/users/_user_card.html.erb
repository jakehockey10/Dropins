<%= link_to user do %>
  <div class="media card invite-friend">
    <div class="media-left media-middle">
      <%= avatar_for user, size: :thumb %>
    </div>
    <div class="media-body" style="padding-top: 15px;">
      <h4 class="media-heading" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 120px;"><%= user.name %></h4>
      <p><small>Has attended <%= pluralize(user.dropins.count, 'dropin') %>.</small></p>
    </div>
  </div>
<% end %>