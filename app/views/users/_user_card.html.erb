<div class="col-md-3">
  <div class="thumbnail">
    <%= avatar_for user, size: :thumb, style: 'width: 100%; height: 150px;' %>
    <div class="caption">
      <h4><%= user.name %></h4>
      <%= render 'users/follow_form', user: user %>


      <!-- Not working! -->
      <% if User.in_group(@group).as(:manager).include? user %>
        <h4><small class="pull-right">Manager</small></h4>
      <% end %>
    </div>
  </div>
</div>