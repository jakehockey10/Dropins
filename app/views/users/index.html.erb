<% provide(:title, 'All users') %>

<h1 class="page-header">All users</h1>

<div class="row">
  <div class="col-md-offset-1 col-md-10 card">
    <!--<div class="panel panel-default">-->
      <!--<div class="panel-heading">-->
        <%= search_form_for @q, class: 'navbar-form', remote: 'true' do |f| %>
          <%= f.label :first_name_or_second_name_cont, 'name contains' %>
          <div class="input-group">
            <%= f.text_field :first_name_or_second_name_cont, class: 'form-control' %>
            <span class="input-group-btn">
              <%= button_tag class: 'btn btn-info' do %>
                <span class="glyphicon glyphicon-search"></span>
              <% end %>
            </span>
          </div>
        <% end %>
      <!--</div>-->
      <div class="panel-body">
        <%= render 'users_table' %>
      </div>
    <!--</div>-->
  </div>
</div>
