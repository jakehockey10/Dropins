<% provide(:title, 'Edit user') %>

<h1 class="page-header">Update your profile</h1>

<div class="row">

  <aside class="col-xs-12 col-sm-4 col-md-4">
    <section>
      <div class="center">
        <%= gravatar_for @user, size: 200, border: true %>
        <br>
        <a href="http://gravatar.com/emails" target="_blank">change</a>
      </div>
    </section>
    <% if !@user.has_valid_wepay_access_token? || !@user.has_wepay_access_token? %>
      <section>
        <p>
          <strong>Please create a WePay account to manage your money:</strong>
        </p>
        <p>
          <% redirect_uri = url_for(controller: 'users', action: 'oauth', user_id: @user.id, host: request.host_with_port) %>
          <%= link_to 'Click here to create your account', @user.wepay_authorization_url(redirect_uri), class: 'btn btn-primary' %>
        </p>
      </section>
    <% end %>
  </aside>

  <div class="col-xs-12 col-sm-8 col-md-6">
    <%= bootstrap_form_for(@user) do |f| %>
      <%= render partial: 'users/fields', locals: { f: f, hide_labels: false } %>
      <%= f.submit 'Save changes', class: 'btn btn-primary btn-users-edit' %>
    <% end %>
  </div>
</div>