<% provide(:title, 'Edit user') %>

<%= render 'make_withdrawal_modal' %>

<h1 class="page-header">Manage your profile</h1>

<% if @user.admin? %>
  <div class="row">
    <div class="col-md-12">
      <ul class="nav nav-pills nav-justified">
        <li role="user" class="active">
          <a href="#user" data-toggle="tab">About me</a>
        </li>
        <li role="wepay">
          <a href="#wepay" data-toggle="tab">WePay</a>
        </li>
      </ul>

      <div class="tab-content" style="margin-top: 20px;">
        <div class="tab-pane fade in active" id="user">
          <%= render 'users/edit_user' %>
        </div>
        <div class="tab-pane fade" id="wepay">
          <%= render 'users/manage_wepay' %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <%= render 'users/edit_user' %>
<% end %>


