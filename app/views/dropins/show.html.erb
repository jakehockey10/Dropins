<% provide(:title, @dropin.description) %>

<%= render 'pay_modal' %>
<%# render 'invite_modal' %>
<%= render 'dropin_creator_email_modal' %>
<%= render 'email_attendees_modal' %>
<div class="page-header">
  <h1>
    <%= @dropin.description %>
    <small>(<%= @dropin.id.ordinalize %> dropin)</small>
  </h1>
</div>

<div class="row">
  <%= render 'dropin_aside' %>

  <div class="col-sm-8 col-md-8 dropin-skaters">
    <div class="above_skaters_table">
      <%= render 'above_skaters_table' %>
    </div>

    <div class="skaters_table">
      <%= render 'skaters_table' %>
    </div>
  </div>
</div>
