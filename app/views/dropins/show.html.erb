<% provide(:title, 'Dropin') %>

<div class="page-header">
  <h1>Dropin <%= @dropin.id %></h1>
</div>

<div class="row">
  <aside class="col-sm-4 col-md-4">
    <section>
      <h1>
        <strong>Date:</strong>
        <%= @dropin.date.to_datetime.in_time_zone.strftime('%A %b %d, %G %l:%M %p') %>
      </h1>
    </section>
    <section>
      <h1>
        <strong>Price/player:</strong>
        <%= number_to_currency(@dropin.price) %>
      </h1>
    </section>
    <section>
      <h1><strong>Terms & Conditions:</strong></h1>
      <p>
        I acknowledge that by clicking Join Dropin, I am obligated to
        attend said dropin and pay the amount listed for this dropin
        unless cancellation is received within 4 hours of the start time.
      </p>
    </section>
    <section>
      <%= link_to 'Edit', edit_dropin_path(@dropin), class: 'btn btn-lg btn-default' if current_user.admin? %>
      <%= link_to 'Back', dropins_path, class: 'btn btn-lg btn-default' %>
    </section>
  </aside>
  <div class="col-sm-8 col-md-8 dropin-skaters">
    <%= render 'attendances/form' if signed_in? %>

    <%= render 'skaters_table' %>
  </div>
</div>