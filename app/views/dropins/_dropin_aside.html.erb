<aside class="col-sm-4 col-md-4">
  <section>
    <%= button_tag fa_icon('user', text: 'Email Creator'),
                   class: 'email-dropin-creator btn btn-sm btn-default' if @dropin.is_in_the_future? %>
    <%= button_tag fa_icon('send', text: 'Invite Skaters'),
                   class: 'invite-skaters btn btn-sm btn-default' if @dropin.is_not_full && current_user.id == @dropin.user_id %>
    <%= button_tag fa_icon('users', text: 'Email Attendees'),
                   class: 'email-attendees btn btn-sm btn-default' if current_user.id == @dropin.user_id %>
  </section>
  <section>
    <h1>
      <strong>Date:</strong>
      <span id="dropin-date-time"><%= @dropin.date.in_time_zone.strftime('%A %b %d, %G %l:%M %p') %></span>
    </h1>
  </section>
  <section>
    <h1>
      <strong>Price/player:</strong>
      <span id="dropin-price-per-player"><%= number_to_currency(@dropin.price) %></span>
    </h1>
  </section>
  <section>
    <h1>
      <strong>Rink:</strong>
      <span id="dropin-rink"><%= @dropin.rink.name %></span>
    </h1>
  </section>
  <section class="card">
    <h1><strong>Terms & Conditions:</strong></h1>
    <p id="dropin-terms-and-conditions">
      By signing up, you are committing to attending this dropin.
      As a reminder, we are not responsible for injury, play at your
      own risk.  Under certain circumstances, one may request that
      they be removed from the dropin due "something coming up."  To do
      so, please use the contact page found <%= link_to 'here', contact_path %>.
    </p>
  </section>
  <section>
    <%= link_to fa_icon('pencil-square-o', text: 'Edit'), edit_dropin_path(@dropin), class: 'btn btn-lg btn-default' if current_user.admin? && current_user.id == @dropin.user.id %>
    <%= link_to fa_icon('arrow-left', text: 'Back'), dropins_path, class: 'btn btn-lg btn-default' %>
  </section>
</aside>