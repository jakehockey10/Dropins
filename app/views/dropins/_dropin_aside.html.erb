<aside class="col-sm-4 col-md-4">
  <section>
    <h1>
      <strong>Date:</strong>
      <span id="dropin-date-time"><%= @dropin.date.to_datetime.in_time_zone.strftime('%A %b %d, %G %l:%M %p') %></span>
    </h1>
  </section>
  <section>
    <h1>
      <strong>Price/player:</strong>
      <span id="dropin-price-per-player"><%= number_to_currency(@dropin.price) %></span>
    </h1>
  </section>
  <section>
    <h1>
      <strong>Rink:</strong>
      <span id="dropin-rink"><%= @dropin.rink.name %></span>
    </h1>
  </section>
  <section class="card">
    <h1><strong>Terms & Conditions:</strong></h1>
    <p id="dropin-terms-and-conditions">
      By signing up, you are committing to attending this dropin.
      Under certain circumstances, one may request that they be
      removed from the dropin due "something coming up."  To do
      so, please use the contact page found <%= link_to 'here', contact_path %>.
    </p>
  </section>
  <%# if current_user.show_pay_for_dropin_button(@dropin) && current_user.has_valid_wepay_access_token? %>
    <!--<section>-->
      <%# link_to 'Pay for dropin',
#                   pay_dropin_path(@dropin),
#                   class: 'btn btn-danger btn-large',
#                   id: 'pay-now-button',
#                   data: { 'loading-text' => 'Loading...' },
                  remote: true %>
    <!--</section>-->
  <%# end %>
  <section>
    <%= link_to 'Edit', edit_dropin_path(@dropin), class: 'btn btn-lg btn-default' if current_user.admin? && current_user.id == @dropin.user.id %>
    <%= link_to 'Back', dropins_path, class: 'btn btn-lg btn-default' %>
  </section>
</aside>