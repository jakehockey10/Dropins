<%= will_paginate dropins %>
<table class="table table-striped table-bordered">
  <thead>
  <tr>
    <th class="center">Date</th>
    <th class="center">Actions</th>
  </tr>
  </thead>

  <tbody>
  <% dropins.each do |dropin| %>
    <tr id="<%= dropin.id %>">
      <td><%= dropin.date.strftime('%A') %><br/><%= dropin.date.strftime('%b %e, %Y at %I:%M %p') %></td>
      <td class="center">
        <div class="btn-group">
          <%= link_to raw('<span class="glyphicon glyphicon-eye-open"></span>'), dropin, class: 'btn btn-sm btn-default' %>
          <%= link_to raw('<span class="glyphicon glyphicon-edit"></span>'), edit_dropin_path(dropin), class: 'btn btn-sm btn-default' if current_user.admin? %>
          <%= link_to raw('<span class="glyphicon glyphicon-remove"></span>'), dropin, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-sm btn-danger' if current_user.admin? %>
        </div>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>