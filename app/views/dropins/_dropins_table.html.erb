<div class="center">
  <%= will_paginate dropins %>
</div>
<table class="table table-striped table-bordered">
  <thead>
  <tr>
    <th class="center">Date</th>
    <th class="center">Price</th>
    <th class="center">Actions</th>
  </tr>
  </thead>

  <tbody>
  <% dropins.each do |dropin| %>
    <tr id="<%= dropin.id %>">
      <td><%= dropin.date.strftime('%A') %><br/><%= dropin.date.strftime('%b %e, %Y at %I:%M %p') %></td>
      <td class="center"><%= number_to_currency(dropin.price, unit: '$') %></td>
      <td class="center">
        <div class="btn-group">
          <%= link_to raw('<span class="glyphicon glyphicon-eye-open"></span>'),
                      dropin,
                      class: 'btn btn-sm btn-default view-dropin',
                      data: { toggle: 'tooltip', placement: 'left', title: 'View/Register for dropin' } %>
          <%= link_to raw('<span class="glyphicon glyphicon-edit"></span>'),
                      edit_dropin_path(dropin),
                      class: 'btn btn-sm btn-default edit-dropin',
                      data: { toggle: 'tooltip', placement: 'top', title: 'Edit dropin' } if current_user.admin? %>
          <%= link_to raw('<span class="glyphicon glyphicon-remove"></span>'),
                      dropin,
                      method: :delete,
                      class: 'btn btn-sm btn-danger delete-dropin',
                      data: { confirm: 'Are you sure?', toggle: 'tooltip', placement: 'right', title: 'Delete dropin' } if current_user.admin? %>
        </div>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>