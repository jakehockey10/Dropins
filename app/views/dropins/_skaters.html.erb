<h3>
  <div class="row">
    <div class="col-md-6">Skaters (<%= @dropin.skaters.count %>)</div>
    <div class="col-md-6">
      <span class="pull-right">
        <%= button_tag fa_icon('send', text: 'Invite Skaters'),
                       class: 'invite-skaters btn btn-sm btn-default' if @dropin.is_not_full && current_user.id == @dropin.user_id %>
        <%= button_tag fa_icon('envelope-o', text: 'Email Attendees'),
                       class: 'email-attendees btn btn-sm btn-default' if @dropin.is_not_full && current_user.id == @dropin.user_id %>
      </span>
    </div>
  </div>
</h3>
<% if @dropin.skaters.any? %>
  <ol class="skaters">
    <% @dropin.skaters.each do |skater| %>
      <%= render 'users/skater', skater: skater %>
    <% end %>
  </ol>
<% end %>