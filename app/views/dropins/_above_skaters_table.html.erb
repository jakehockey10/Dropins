<div class="row">
  <% if @dropin.date <= Time.now %>
      <p class="card">
        It is too late to sign up for this dropin.  If you believe
        you are seeing this message in error, please use the contact
        form <%= link_to 'here', contact_path %> to let
        me know
      </p>
  <% elsif @dropin.full? %>
      <p class="card">
        The dropin is currently full.  Use the contact
        page <%= link_to 'here', contact_path %>
        to be put on the wait-list in case of a spot opening up.
        You will be contacted if you are next in the wait-list and
        there is an available slot in the roster.
      </p>
  <% elsif @dropin.user_is_attending(current_user.id) %>
      <p class="card">
        You are signed up for this dropin!
        <% unless @dropin.user_paid(current_user) %>
            Cash is a hassle.  Feel free to pay online :)
            <%= link_to fa_icon('credit-card') + ' / ' + fa_icon('university', text: 'Pay online'),
                        pay_dropin_path(@dropin),
                        # class:  'btn btn-primary btn-lg btn-block',
                        id:     'pay-now-button',
                        data:   {'loading-text' => "#{fa_icon 'spinner pulse'} Loading..."},
                        remote: true %>
        <% end %>
      </p>
  <% else %>
      <%= render 'attendances/form' if logged_in? %>
  <% end %>
</div>