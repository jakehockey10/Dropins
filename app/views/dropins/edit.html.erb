<% provide(:title, 'Editing Dropin') %>

<div class="page-header">
  <h1>Editing Dropin <%= @dropin.id %></h1>
</div>

<div class="row">
  <div class="col-lg-offset-3 col-lg-6">
    <%= render 'form', dropin: @dropin %>
  </div>
</div>


<%= link_to 'Show', @dropin, class: 'btn btn-lg btn-primary' %>
<%= link_to 'Back', dropins_path, class: 'btn btn-lg btn-default' %>
