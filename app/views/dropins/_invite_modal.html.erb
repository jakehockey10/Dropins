<%= bootstrap_form_tag(url: {controller: :invite, action: :invite}, method: 'get') do |f| %>
<div class="modal fade" id="invite_modal" tabindex="-1" role="dialog" aria-labelledby="Invite Modal" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <%= button_tag raw('<span aria-hidden="true">&times;</span><span class="sr-only">Close</span>'),
                       class: 'close',
                       data: { dismiss: 'modal' } %>
        <h4 class="modal-title" id="invite_modal_label">Invite Skaters</h4>
      </div>

      <div class="modal-body">
        <%= f.hidden_field :dropin_id, value: @dropin.id %>

        <div class="row">
          <aside class="col-sm-3 col-md-3">
            <h1>Available Contacts:</h1>
            <section>
              Gmail contacts: <%= @gmail_contacts.count %>
              <div id="gmail-info-tooltip" class="pull-right" data-toggle="tooltip">
                <i class="glyphicon glyphicon-info-sign"></i>
              </div>
              <script type="text/javascript" charset="utf-8">
                  $('#gmail-info-tooltip').tooltip({
                      title: 'Attempts to pull Gmail contacts (not all) and only grab the ones with valid emails.',
                      placement: 'bottom',
                      delay: 500
                  });
              </script>
            </section>
            <section>
              Contacts with accounts: <%= @user_contacts.count %>
            </section>
            <section>
              <%= link_to image_tag('icon_gmail.png', size: '25x25') + '  Import Gmail Contacts',
                          "/contacts/gmail?state=#{@dropin.id}",
                          id: 'import-gmail-link',
                          class: 'btn btn-xs btn-danger' %>
              <script type="text/javascript" charset="utf-8">
                  $('#import-gmail-link').tooltip({
                      title: '<%= @contacts.count > 0 ? 'last imported ' + time_ago_in_words(@contacts.first.created_at) + ' ago.' : 'No Gmail contacts imported.' %>',
                      placement: 'bottom',
                      delay: 500
                  });
              </script>
            </section>

          </aside>
          <div class="col-sm-9">
            <div class="control-group">
              <%= f.autocomplete_field :users,
                                       autocomplete_gmail_contact_name_users_path,
                                       'data-delimiter' => ',',
                                       multiple: true,
                                       placeholder: 'All emails, separated by commas...',
                                       class: 'form-control',
                                       id: 'users' %>
            </div>
            <%= f.text_area :message,
                            as: :text,
                            rows: 7,
                            hide_label: true,
                            placeholder: 'Add to default message...' %>
          </div>
        </div>

      </div>
      <div class="modal-footer">
        <%= button_tag 'Insert Date/Time',
                       class: 'btn btn-sm btn-success pull-left',
                       id: 'insert-date-time',
                       type: 'button' %>
        <%= button_tag 'Insert Price-per-player',
                       class: 'btn btn-sm btn-success pull-left',
                       id: 'insert-price-per-player',
                       type: 'button' %>
        <%= button_tag 'Insert Rink',
                       class: 'btn btn-sm btn-success pull-left',
                       id: 'insert-rink',
                       type: 'button' %>
        <%= button_tag 'Insert Terms & Conditions',
                       class: 'btn btn-sm btn-success pull-left',
                       id: 'insert-terms-and-conditions',
                       type: 'button' %>
        <%= f.submit 'Send', class: 'btn btn-sm btn-primary', data: { disable_with: 'Loading...' } %>
        <%= button_tag 'Close',
                       class: 'btn btn-sm btn-default',
                       data: { dismiss: 'modal' } %>
      </div>
    </div>
  </div>
</div>
<% end %>