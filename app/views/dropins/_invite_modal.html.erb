<%= bootstrap_form_tag(url: {controller: :invite, action: :invite}, method: 'get') do |f| %>
<div class="modal fade" id="invite_modal" tabindex="-1" role="dialog" aria-labelledby="Invite Modal" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <%= button_tag raw('<span aria-hidden="true">&times;</span><span class="sr-only">Close</span>'), class: 'close', data: { dismiss: 'modal' } %>
        <h4 class="modal-title" id="invite_modal_label">Invite Skaters</h4>
      </div>
      <div class="modal-body">
        <%# bootstrap_form_tag(url: {controller: :invite, action: :import}, method: 'get', remote: true) do |f| %>
            <%# f.select :from, %w(Gmail Yahoo Hotmail) %>
            <%# f.email_field :login, value: 'name@example.com' %>
            <%# f.password_field :password %>
            <%# f.submit 'Submit', class: 'btn btn-md btn-default' %>
        <%# end %>

        <%= link_to 'Import Gmail Contacts', '/contacts/gmail', id: 'import-gmail-link' %>

        <%= f.hidden_field :dropin_id, value: @dropin.id %>
        <%= f.text_field :users, placeholder: 'All emails, separated by commas...' %>
        <%= f.text_area :message, as: :text, rows: 5, placeholder: 'Add to default message...' %>

      </div>
      <div class="modal-footer">
        <%= button_tag 'Insert Date/Time', class: 'btn btn-sm btn-success pull-left', id: 'insert-date-time', type: 'button' %>
        <%= button_tag 'Insert Price-per-player', class: 'btn btn-sm btn-success pull-left', id: 'insert-price-per-player', type: 'button' %>
        <%= button_tag 'Insert Rink', class: 'btn btn-sm btn-success pull-left', id: 'insert-rink', type: 'button' %>
        <%= button_tag 'Insert Terms & Conditions', class: 'btn btn-sm btn-success pull-left', id: 'insert-terms-and-conditions', type: 'button' %>
        <%= f.submit 'Send', class: 'btn btn-primary' %>
        <%= button_tag 'Close', class: 'btn btn-default', data: { dismiss: 'modal' } %>
      </div>
    </div>
  </div>
</div>
<% end %>