<%= form_for(:email_attendees_dropin, url: email_attendees_dropin_path) do |f| %>
    <div class="modal fade" id="email_attendees_modal" tabindex="-1" role="dialog" aria-labelledby="Email Attendees Modal" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <%= render partial: 'shared/modal_header', locals: { title: 'Email Dropin Attendees' } %>

          <%= hidden_field_tag :dropin_id, value: @dropin.id %>

          <div class="modal-body">

            <div class="row">
              <div class="col-md-offset-2 col-md-8">
                <%= f.label :subject, hidden: true %>
                <%= f.text_field :subject, placeholder: 'Subject', class: 'form-control' %>
                <%= f.label :message, hidden: true %>
                <%= f.text_area :message, placeholder: 'Message', rows: 5, class: 'form-control' %>
              </div>
            </div>

          </div>
          <div class="modal-footer">

            <%= f.button 'Send',
                         class: 'btn btn-sm btn-primary',
                         data:  {disable_with: "#{fa_icon 'spinner pulse'} Sending..."} %>
            <%= button_tag 'Close',
                           class: 'btn btn-sm btn-default',
                           data:  {dismiss: 'modal'} %>
          </div>
        </div>
      </div>
    </div>
<% end %>