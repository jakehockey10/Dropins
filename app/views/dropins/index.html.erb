<% provide(:title, 'Dropins') %>

<div class="page-header">
  <h1>Dropins</h1>
</div>

<div class="row">
  <% if current_user.admin? %>
  <aside class="col-sm-4 col-md-4">
    <!--<section>-->
      <h1>Create a new dropin:</h1>
      <%= render 'dropins/form', dropin: Dropin.new %>
    <!--</section>-->
  </aside>
  <% end %>
  <div class="<% unless current_user.admin? %>col-md-offset-2 <% end %>col-sm-8 col-md-8 dropins-table">
    <%= render 'dropins_table', dropins: @dropins %>
  </div>
</div>