<% provide(:title, 'Dropins') %>

<div class="page-header">
  <h1>Dropins</h1>
</div>

<div class="row">
  <% if current_user.admin? %>
    <aside class="col-md-4">
      <h1>Create a new dropin:</h1>
      <%= render 'dropins/form', dropin: Dropin.new, remote: true %>
    </aside>
  <% end %>
  <div id="dropins" class="<% unless current_user.admin? %>col-md-offset-2 <% end %>col-md-8 dropins-table" style="margin-top: 20px;">
    <%= render @dropins %>
  </div>
</div>