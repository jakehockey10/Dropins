<%= javascript_include_tag 'https://www.wepay.com/js/iframe.wepay.js' %>
<div class="modal fade" id="pay_modal" tabindex="-1" role="dialog" aria-labelledby="Pay Modal" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <%= button_tag raw('<span aria-hidden="true">&times;</span><span class="sr-only">Close</span>'), class: 'close', data: { dismiss: 'modal' } %>
        <h4 class="modal-title" id="pay_modal_label">Pay for dropin</h4>
      </div>
      <div class="modal-body">

      </div>
      <div class="modal-footer">
        <%= button_tag 'Close', class: 'btn btn-default', data: { dismiss: 'modal' } %>
      </div>
    </div>
  </div>
</div>