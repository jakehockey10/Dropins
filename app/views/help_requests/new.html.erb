<% provide(:title, 'Request help') %>

<div class="page-header">
  <h1>Request help</h1>
</div>

<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <div class="media card">
      <h2 class="card-header">
        <small><p>How can we help you?</p></small>
      </h2>
      <hr class="card-break"/>
      <%= form_for(:help_request, url: help_requests_path) do |f| %>
          <%= f.hidden_field :email, value: current_user.email %>

          <%= f.label :message, hidden: true %>
          <%= f.text_area :message, class: 'form-control', rows: 5 %>
          <hr class="card-break"/>
          <div class="btn-toolbar" role="toolbar">
            <%= f.button 'Submit',
                         class: 'btn btn-link card-link pull-right',
                         data:  { disable_with: "#{fa_icon 'spinner pulse'} Sending..." } %>
          </div>
      <% end %>
    </div>

  </div>
</div>