<% provide(:title, 'Landing Page') %>
<div class="jumbotron">
  <h1>
    Welcome to Rosenbridge <span class="label label-default">beta</span>!
  </h1>
  <p>
    Are you interesting in finding out more about what Rosenbridge is all about?
    Please give us your email and we'll send you information as it becomes available :)
  </p>
  <div class="row">
    <div class="col-lg-offset-4 col-sm-4 col-md-4">
      <%= bootstrap_form_for @interested_person, layout: :horizontal, url: '/interested_person', method: :post, remote: true do |f| %>
        <%= render 'shared/error_messages', object: f.object %>

        <%= f.text_field :email, hide_label: true, placeholder: 'email' %>

        <%= submit_tag "I'm interested", class: 'btn btn-primary' %>

      <% end %>
    </div>
  </div>
</div>