<% provide(:title, 'Landing Page') %>
<div class="jumbotron">
  <h1>
    Welcome to Rosenbridge <span class="label label-default">beta</span>!
  </h1>
  <p>
    Are you interesting in finding out more about what Rosenbridge is all about?
    Please give us your email and we'll send you information as it becomes available :)
  </p>
  <div class="row">
    <div class="col-lg-offset-3 col-sm-6 col-md-6">
      <%= form_for @interested_person, url: '/interested_person', method: :post, remote: true do |f| %>
        <%= f.label :email %>
        <%= f.text_field :email %>

        <%= submit_tag "I'm interested", class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
</div>