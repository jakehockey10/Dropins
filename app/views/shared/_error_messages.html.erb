<% if object.errors.any? %>
  <div id="error_explanation" style="overflow: visible;">
    <div class="alert alert-danger card-alert">
      <%= fa_icon 'exclamation-triangle 2x', class: 'text-danger' %>
      <span class="sr-only">Error:</span>
      The form contains <%= pluralize(object.errors.count, 'error') %>
    </div>
    <ul>
      <% object.errors.full_messages.each do |msg| %>
        <li>* <%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>