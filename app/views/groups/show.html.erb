<div class="row">
  <div class="col-md-offset-2 col-md-8 card">
    <div class="jumbotron">
      <h1 class="card-header"><%= @group.name %></h1>
    </div>
    <hr class="card-break">
    <%= form_for(:group_invite, url: group_invites_path) do |f| %>
        <%= f.text_field :followers, class: 'tokenize-followers form-control' %>
        <%= f.submit 'Invite', class: 'btn btn-primary' %>
    <% end %>
    <p class="lead"><strong>TODO:</strong> Need to tokenize invitations in a field here.</p>
    <h2 class="card-header">Members:</h2>
    <div class="row">
      <%= render partial: 'users/user_card', collection: @group.users, as: 'user' %>
    </div>
  </div>
</div>

<script type="text/javascript" charset="utf-8">
  $('input.tokenize-followers').tokenfield({
    autocomplete: {
      source: <%= tokenfield_source(current_user) %>,
      delay: 100,
       create: function () {
       $(this).data('ui-autocomplete')._renderItem = function (ul, item) {
       return $('<li>')
       .addClass('media')
       .append('<a class="media-left" href="#">' + item.profile_picture + '</a><div class="media-body"><h4 class="media-heading">' + item.label + '</h4>' + item.value + '</div>')
       .appendTo(ul);
       };
       }
    },
    showAutoCompleteOnFocus: true
  });
</script>
