<% provide(:title, 'New Group') %>

<h1>New Group</h1>

<div class="row">
  <div class="col-md-offset-3 col-md-6 card">
    <h2 class="card-header">Let's create this group</h2>
    <hr class="card-break">
    <%= form_for(@group) do |f| %>
        <%= render 'shared/error_messages', object: f.object %>

        <%= f.label :name, hidden: true %>
        <%= f.text_field :name, placeholder: 'Name of group', class: 'form-control' %>

        <hr class="card-break">
        <div class="btn-toolbar" role="toolbar">
          <%= f.button 'Create group', class: 'btn btn-link card-link pull-right', data: {disable_with: "#{fa_icon 'spinner pulse'} Sending..."} %>
        </div>

    <% end %>
  </div>
</div>