<%= form_for :conversation, url: :conversations do |f| %>

    <%= f.label :recipients %>
    <%= f.text_field :recipients, class: 'tokenize-recipients form-control' %>
    <%= f.label :subject %>
    <%= f.text_field :subject, class: 'form-control' %>
    <%= f.label :body %>
    <%= f.text_area :body, class: 'form-control' %>

    <div class="row">
      <div class="col-md-6">
        <%= f.button 'Send',
                     class: 'btn btn-primary btn-block',
                     data:  {disable_with: "#{fa_icon 'spinner pulse'} Sending..."} %>
      </div>
      <div class="col-md-6">
        <%= f.submit 'Reset', type: :reset, class: 'btn btn-danger' %>
      </div>
    </div>

<% end %>

<script type="text/javascript" charset="utf-8">
    $('input.tokenize-recipients').tokenfield({
        autocomplete: {
            source: <%= tokenfield_source(current_user) %>,
            delay: 100,
            create: function () {
                $(this).data('ui-autocomplete')._renderItem = function (ul, item) {
                    return $('<li>')
                            .addClass('media')
                            .append('<a class="media-left" href="#">' + item.profile_picture + '</a><div class="media-body"><h4 class="media-heading">' + item.label + '</h4>' + item.value + '</div>')
                            .appendTo(ul);
                };
            }
        },
        showAutoCompleteOnFocus: true
    });
</script>
