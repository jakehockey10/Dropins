<%= bootstrap_form_for :conversation, url: :conversations do |f| %>
  <%= f.text_field :recipients, class: 'tokenize-recipients' %>
  <%= f.text_field :subject %>
  <%= f.text_area :body %>
  <%= f.submit 'Send', class: 'btn btn-primary', data: { disable_with: 'Sending...' } %>
  <%= f.submit 'Reset', type: :reset, class: 'btn btn-danger' %>
<% end %>

<script type="text/javascript" charset="utf-8">
  $('input.tokenize-recipients').tokenfield({
     autocomplete: {
      source: <%= raw(current_user.relationships.map { |r| User.find(r.followed_id) }.map{ |u| u.email }) %>,
      delay: 100
    },
    showAutoCompleteOnFocus: true
  });
</script>