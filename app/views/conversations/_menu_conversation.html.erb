<%= content_tag_for(:div, conversation, class: 'media') do |conversation| %>
  <div class="media-body">
    <h4 class="media-heading">
      <%= conversation.subject %>
      <small class="pull-right">Sent: <%= time_ago_in_words(conversation.updated_at) %> ago</small>
    </h4>
    <p class="truncate"><small><%= truncate(conversation.last_message.body) %></small></p>
  </div>

<% end %>