<%= content_tag_for(:li, conversation, class: 'media card') do |conversation| %>
  <div class="media-left">
    <%= link_to avatar_for(conversation.originator), user_path(conversation.originator.id) %>
  </div>
  <div class="media-body">
    <h4 class="media-heading">
      <%= link_to conversation.subject, conversation_path(conversation) %>
      <span class="pull-right">
        <% if conversation.is_completely_trashed?(current_user) %>
          <%= link_to untrash_conversation_path(conversation), method: :post do %>
            <%= fa_stacked_icon 'trash-o', base: 'ban', base_options: { class: 'text-danger' } %>
          <% end %>
        <% else %>
          <%= link_to fa_icon('trash-o'), trash_conversation_path(conversation), method: :post %>
        <% end %>
      </span>
    </h4>
    <p>
      <% filtered_participants = conversation.participants.reject do |u| u.id == current_user.id end %>
      to: <%= filtered_participants.map { |fp| fp.name }.to_sentence %>
    </p>
    <p>
      from: <%= conversation.originator.name %>
    </p>
  </div>

<% end %>