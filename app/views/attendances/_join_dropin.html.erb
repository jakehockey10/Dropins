<div class="row">
  <%= bootstrap_form_for(current_user.attendances.build(dropin_id: @dropin.id), remote: true) do |f| %>
    <div class="col-md-6">
      <%= f.hidden_field :dropin_id %>
      <%= f.submit 'Join Dropin and pay at rink (cash)',
                   class: 'btn btn-primary btn-lg btn-block',
                   id: 'join_dropin',
                   data: { disable_with: 'Loading...' } %>
    </div>
    <div class="col-md-6">
      <%= link_to 'Join Dropin and pay online',
                  pay_dropin_path(@dropin),
                  class: 'btn btn-danger btn-lg btn-block',
                  id: 'pay-now-button',
                  data: { 'loading-text' => 'Loading...' },
                  remote: true %>
    </div>
  <% end %>
</div>