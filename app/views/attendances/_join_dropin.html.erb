<%= bootstrap_form_for(current_user.attendances.build(dropin_id: @dropin.id), remote: true) do |f| %>
    <%= f.hidden_field :dropin_id %>
    <div class="row">
      <div class="col-md-offset-3 col-md-6">
        <%= f.submit 'Join Dropin', class: 'btn btn-primary btn-lg btn-block' %>
      </div>
    </div>
<% end %>