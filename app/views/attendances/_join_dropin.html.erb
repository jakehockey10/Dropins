<div class="row">
  <%= bootstrap_form_for(current_user.attendances.build(dropin_id: @dropin.id), remote: true) do |f| %>
    <div class="col-md-6">
      <%= f.hidden_field :dropin_id %>

      <%= f.button fa_icon('money 2x'),
                   class: 'btn btn-success btn-lg btn-block',
                   data: { disable_with: "#{fa_icon 'spinner pulse 2x'} Loading..." } %>
    </div>
    <div class="col-md-6">
      <%= link_to fa_icon('credit-card 2x'),
                  pay_dropin_path(@dropin),
                  class: 'btn btn-primary btn-lg btn-block',
                  id: 'pay-now-button',
                  data: { 'loading-text' => "#{fa_icon 'spinner pulse 2x'} Loading..." },
                  remote: true %>
    </div>
  <% end %>
</div>