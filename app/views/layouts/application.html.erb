<!DOCTYPE html>
<html>
<head>
  <title><%= full_title(yield(:title)) %></title>
  <%= favicon_link_tag 'favicon.ico', rel: 'short icon' %>

  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track' => true %>
  <!-- Optional theme -->
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.4/css/bootstrap-theme.min.css">
  <%= javascript_include_tag 'application', 'data-turbolinks-track' => true %>
  <script type="text/javascript" src="https://www.wepay.com/js/iframe.wepay.js"></script>
  <%= csrf_meta_tags %>
  <%= render 'layouts/shim' %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body class="<%= yield :landing_css %>">
<%= render 'layouts/header' %>
<div class="container" id="main">

  <!-- Main Content -->
  <% flash.each do |message_type, message| %>
      <%= content_tag(:div, message, class: "alert alert-#{message_type} alert-dismissable card-alert") do %>
          <%= message %>
          <button type="button" class="close">&times</button>
      <% end %>
  <% end %>

  <%= yield %>

  <%= debug(params) if Rails.env.development? %>

  <%= render 'layouts/footer' %>

</div>
</body>
</html>
