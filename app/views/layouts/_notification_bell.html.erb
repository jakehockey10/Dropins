<li class="dropdown">
  <% if unread_count.to_i > 0 %>
    <%= link_to '#', class: 'dropdown-toggle', data: { toggle: 'dropdown' } do %>
      <%= fa_icon 'bell', class: 'new-notification', text: raw("<span class='badge'>#{unread_count}</span> Notifications") %>
    <% end %>
    <ul class="dropdown-menu notification-menu">
      <% mailbox.inbox.unread(current_user).each do |m| %>
        <li>
          <%= link_to render('conversations/menu_conversation', conversation: m), conversation_path(m) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= link_to '#', class: 'dropdown-toggle', data: { toggle: 'dropdown' } do %>
      <%= fa_icon 'bell-o', text: 'Notifications' %>
    <% end %>
    <ul class="dropdown-menu notification-menu">
      <li><%= link_to 'There are no new notifications...', '#' %></li>
    </ul>
  <% end %>
</li>