<header class="navbar navbar-fixed-top navbar-inverse">
  <div class="navbar-inner">
    <div class="container">
      <%= link_to raw("Dropins <span class='label label-default'>Beta</span>"), root_path, id: 'logo' %>
      <nav>
        <ul class="nav navbar-nav navbar-right">
          <% if signed_in? %>
            <li class="dropdown">
              <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                Menu <b class="caret"></b>
              </a>
              <ul class="dropdown-menu">
                <li><%= link_to 'Users', users_path %></li>
                <li><%= link_to 'Dropins', dropins_path %></li>
                <li><%= link_to 'Rinks', rinks_path, data: { no_turbolink: true } %></li>
              </ul>
            </li>
            <li id="fat-menu" class="dropdown">
              <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                <span class="glyphicon glyphicon-cog"></span> <b class="caret"></b>
              </a>
              <ul class="dropdown-menu">
                <li class="disabled"><%= link_to 'Profile', nil %></li>
                <!-- replace nil with current_user when profile page is ready -->
                <li><%= link_to 'Edit Profile', edit_user_path(current_user) %></li>
                <li><%= link_to 'Sign out', signout_path, method: :delete %></li>
                <li class="divider"></li>
                <li><%= link_to 'About', about_path %></li>
                <li><%= link_to 'Contact', contact_path %></li>
                <li><%= link_to 'Help', help_path %></li>
              </ul>
            </li>
          <% else %>
            <li><%= link_to 'Sign in', signin_path %></li>
          <% end %>
        </ul>
      </nav>
    </div>
  </div>
</header>