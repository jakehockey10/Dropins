<nav class="navbar" role="navigation">
  <div class="container-fluid">
    <!-- Brand and toggle get grouped for better mobile display -->
    <div class="navbar-header">
      <% if logged_in? %>
        <%= button_tag type: 'button', class: 'navbar-toggle toggle-menu menu-left push-body', data: { toggle: 'collapse', target: '#navbar-collapse' } do %>
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar" style="background-color: #4DB6AC;"></span>
          <span class="icon-bar" style="background-color: #4DB6AC;"></span>
          <span class="icon-bar" style="background-color: #4DB6AC;"></span>
        <% end %>
      <% end %>
      <%= link_to raw('Dropins <span class="label label-default">Beta</span>'), root_path, id: 'logo', class: 'navbar-brand' %>
    </div>

    <!-- Collect the nav links, forms, and other content for toggling -->
    <div class="collapse navbar-collapse cbp-spmenu cbp-spmenu-vertical cbp-spmenu-left navbar-inverse" id="navbar-collapse">
      <ul class="nav navbar-nav navbar-right">
        <% if logged_in? %>
          <li class="if-mobile">
            <%= link_to avatar_for(current_user,
                                   { size: :thumb,
                                     border: true,
                                     style: 'display: block; margin-left: auto; margin-right: auto;' }),
                        current_user %>
            <p class="text-center" style="display: block; color: #d3d3d3; margin-bottom: 0px;">
              Logged in as
            </p>
            <p class="text-center" style="display: block; color: #d3d3d3; font-size: large">

              <!--<span style="display: inline-block;">-->
                <%= current_user.name %>
                <!--<%= button_to logout_path, method: :delete, class: 'btn-link' do %>-->
                  <!--<span class="glyphicon glyphicon-log-out"></span>-->
                <!--<% end %>-->
              <!--</span>-->
            </p>
            <hr class="header"/>
          </li>

          <!-- Bell was here -->
          <%= render 'layouts/notification_bell' %>

          <li id="fat-menu" class="dropdown">
            <a href="#" class="dropdown-toggle animate-caret" data-toggle="dropdown">
              <%= fa_icon 'bars' %> <%= fa_icon 'caret-down', class: 'caret-down-animate' %>
            </a>
            <ul class="dropdown-menu">
              <li><%= link_to fa_icon('user', text: 'View Profile'), user_path(current_user) %></li>
              <li><%= link_to fa_icon('pencil-square-o', text: 'Edit Profile'), edit_user_path(current_user) %></li>
              <li class="divider"></li>
              <% if current_user.admin? %>
                <li><%= link_to fa_icon('users', text: 'Users'), users_path %></li>
              <% end %>
              <li><%= link_to fa_icon('calendar', text: 'Dropins'), dropins_path %></li>
              <li><%= link_to fa_icon('map-marker', text: 'Rinks'), rinks_path, data: { no_turbolink: true } %></li>
              <li><%= link_to fa_icon('comments-o', text: 'Conversations'), conversations_path %> </li>
              <li class="divider"></li>
              <li><%= link_to fa_icon('sign-out', text: 'Log out'), logout_path, method: :delete %></li>
              <li><%= link_to fa_icon('info-circle', text: 'About'), about_path %></li>
              <li><%= link_to fa_icon('envelope-o', text: 'Contact'), contact_path %></li>
              <li><%= link_to fa_icon('question-circle', text: 'Help'), new_help_request_path %></li>
            </ul>
          </li>
        <% else %>
          <li><%= link_to fa_icon('sign-in', text: 'Log in'), login_path %></li>
        <% end %>
      </ul>
  </div><!-- /.navbar-collapse -->
  </div><!-- /.container-fluid -->
</nav>
