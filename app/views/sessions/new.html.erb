<% provide(:title, 'Sign in') %>

<div class="page-header">
  <h1>Sign in</h1>
</div>

<div class="row">
  <div class="col-lg-offset-4 col-sm-6 col-md-4">
    <%= bootstrap_form_for(:session, url: sessions_path) do |f| %>

      <%= f.text_field :email, hide_label: true, placeholder: 'email' %>
      <%= f.password_field :password, hide_label: true, placeholder: 'password' %>

      <%= f.submit 'Sign in', class: 'btn btn-primary' %>
    <% end %>

    <p><%= link_to 'forgotten password?', new_password_reset_path %></p>

    <p>New user? <%= link_to 'Sign up now!', signup_path %></p>
  </div>
</div>