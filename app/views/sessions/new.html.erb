<% provide(:title, 'Log in') %>

<h1 class="page-header">Log in</h1>

<div class="row">
  <div class="col-xs-offset-2 col-sm-offset-3 col-md-offset-4 col-xs-8 col-sm-6 col-md-4">
    <%= form_for(:session, url: login_path) do |f| %>

        <%= f.label :email, hidden: true %>
        <%= f.email_field :email, placeholder: 'email', class: 'form-control' %>

        <%= f.label :password, hidden: true %>
        <%= f.password_field :password, placeholder: 'password', class: 'form-control' %>

        <%= f.label :remember_me, class: 'checkbox inline' do %>
          <%= f.check_box :remember_me %>
          <span>Remember me on this device</span>
        <% end %>

      <%= f.button 'Log in',
                   class: 'btn btn-primary btn-block',
                   data: { disable_with: "#{fa_icon 'spinner pulse'} Signing in..." } %>
    <% end %>

    <p><%= link_to 'Forgotten password?', new_password_reset_path %></p>

    <p>New user? <%= link_to 'Sign up now!', signup_path %></p>
  </div>
</div>