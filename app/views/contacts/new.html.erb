<% provide(:title, 'Rosenbridge Beta') %>

<div class="page-header">
  <h1>Welcome to Rosenbridge <span class="label label-default">beta</span>!</h1>
</div>
<div class="row">
  <div class="col-lg-offset-3 col-lg-6">
    <div class="well center">
      <p>
        Are you interesting in finding out more about what Rosenbridge is all about? Please give us your email and we'll send you information as it becomes available :)
        Email
      </p>
      <%= bootstrap_form_for(@contact, layout: :horizontal, label_col: 'col-sm-2', control_col: 'col-sm-10', remote: true) do |f| %>
        <%= f.text_field :email, required: true %>
        <%= f.select :language, TwitterCldr::Shared::Languages.all.values %>
        <%= f.hidden_field :nickname %>
        <%= f.submit 'I\'m interested!', class: 'btn btn-primary btn-sm' %>
      <% end %>
    </div>
  </div>
</div>
