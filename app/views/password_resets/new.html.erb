<% provide(:title, 'Reset Password') %>
<h1>Reset Password</h1>

<div class="row">
  <div class="col-lg-offset-4 col-sm-6 col-md-4">
    <%= form_tag password_resets_path, method: :post do %>

      <%= text_field_tag :email, params[:email], class: 'form-control', style: 'margin-bottom: 15px;', placeholder: 'email' %>

      <%= submit_tag 'Reset Password', class: 'btn btn-primary form-control' %>
    <% end %>
  </div>
</div>