<h1>Reset Password</h1>

<div class="row">
  <div class="col-lg-offset-4 col-sm-4 col-md-4">
    <%= bootstrap_form_for @user, url: password_reset_path(params[:id]) do |f| %>
      <%= render 'shared/error_messages', object: f.object %>

      <%= f.password_field :password, hide_label: true, placeholder: 'password' %>
      <%= f.password_field :password_confirmation, hide_label: true, placeholder: 'password confirmation' %>

      <%= f.submit 'Update Password', class: 'btn btn-primary' %>
    <% end %>
  </div>
</div>