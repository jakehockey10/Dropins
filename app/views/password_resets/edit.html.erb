<h1>Reset Password</h1>

<div class="row">
  <div class="col-lg-offset-4 col-sm-4 col-md-4">
    <%= form_for @user, url: password_reset_path(params[:id]) do |f| %>
        <%= render 'shared/error_messages', object: f.object %>

        <%= hidden_field_tag :email, @user.email %>

        <%= f.label :password, hidden: true %>
        <%= f.password_field :password, placeholder: 'password', class: 'form-control' %>

        <%= f.label :password_confirmation, hidden: true %>
        <%= f.password_field :password_confirmation, placeholder: 'password confirmation', class: 'form-control' %>

        <%= f.button 'Update Password',
                     class: 'btn btn-primary',
                     data:  {disable_with: "#{fa_icon 'spinner pulse'} Updating..."} %>
    <% end %>
  </div>
</div>