<div class="row">
  <aside class="col-sm-4 col-md-4">
    <section>
      <%= render 'shared/user_info' %>
    </section>
    <section>
      <%= render 'shared/stats' %>
    </section>
    <%# if !current_user.has_valid_wepay_access_token? || !current_user.has_wepay_access_token? %>
      <!--<section>-->
        <!--<p>-->
          <!--<strong>Please create a WePay account to manage your money:</strong>-->
        <!--</p>-->
        <!--<p>-->
          <!--<%# redirect_uri = url_for(controller: 'users', action: 'oauth', user_id: current_user.id, host: request.host_with_port) %>-->
          <!--<%# link_to 'Click here to create your account', current_user.wepay_authorization_url(redirect_uri), class: 'btn btn-primary' %>-->
        <!--</p>-->
      <!--</section>-->
    <%# end %>
    <section>
      <%= render 'shared/micropost_form' %>
    </section>
  </aside>
  <div class="col-sm-8 col-md-8">

    <!-- Nav tabs -->
    <ul class="nav nav-pills nav-justified">
      <li class="active">
        <a href="#dropins" data-toggle="tab">
          <span class="glyphicon glyphicon-tag"></span>&nbsp;&nbsp;&nbsp;Dropins
        </a>
      </li>
      <li>
        <a href="#calendar" data-toggle="tab">
          <span class="glyphicon glyphicon-calendar"></span>&nbsp;&nbsp;&nbsp;Calendar
        </a>
      </li>
      <li>
        <a href="#rinks" data-toggle="tab">
          <span class="glyphicon glyphicon-tags"></span>&nbsp;&nbsp;&nbsp;Rinks
        </a>
      </li>
      <li>
        <a href="#microposts" data-toggle="tab">
          <span class="glyphicon glyphicon-list-alt"></span>&nbsp;&nbsp;&nbsp;Microposts
        </a>
      </li>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">
      <div class="tab-pane fade in active" id="dropins">
        <h3>Upcoming dropins</h3>
        <ul class="media-list">
          <%= render @dropins %>
        </ul>
      </div>
      <div class="tab-pane fade" id="calendar">
        <%= render 'shared/calendar' %>
      </div>
      <div class="tab-pane fade" id="rinks">
        <h3>Rinks nearby</h3>
        <%= render 'rinks/rinks_table', rinks: @rinks %>
      </div>
      <div class="tab-pane fade" id="microposts">
        <%= render 'shared/feed' %>
      </div>
    </div>

  </div>
</div>