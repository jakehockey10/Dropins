<% provide(:landing_css, 'landing') %>

<div class="page-header landing text-success">
  <h1><small>Sean Le's</small> Dropins <small><span class="label label-default">beta</span></small></h1>
</div>

<div class="center">
  <%= image_tag('SeanRe.jpg', size: '150', class: 'img-circle img-thumbnail popover-dismiss') %>
</div>

<div class="row">
  <div class="col-lg-offset-3 col-lg-6">
      <p class="lead center">
        Dropins is a place where hockey players can sign up and secure a
        spot by paying in advance for private or public dropins.
      </p>
  </div>
</div>

<div class="center">
  <%= link_to 'Sign up', signup_path, class: 'btn btn-info btn-home' %>
  <%= link_to 'Sign in', login_path, class: 'btn btn-info btn-home' %>
</div>