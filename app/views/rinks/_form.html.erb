<%= form_for @rink do |f| %>
    <%= render 'shared/error_messages', object: f.object %>

    <%= f.label :address, hidden: true %>
    <%= f.text_field :address, placeholder: 'Address', class: 'form-control' %>
    <%= f.label :name, hidden: true %>
    <%= f.text_field :name, placeholder: 'Rink name', class: 'form-control' %>
    <p class="small">
      You can search for rinks with the search field in the map. When you click on a rink, it will automatically
      populate the above fields for you.
    </p>
    <%= f.button 'Submit',
                 class: 'btn btn-default',
                 data:  {disable_with: "#{fa_icon 'spinner pulse'} Loading..."} %>
<% end %>