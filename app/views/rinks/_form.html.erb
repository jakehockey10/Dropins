<%= bootstrap_form_for @rink do |f| %>
  <%= render 'shared/error_messages', object: f.object %>

  <%= f.text_field :address, hide_label: true, placeholder: 'Address' %>
  <%= f.text_field :name, hide_label: true, placeholder: 'Rink name' %>
  <p class="small">
    You can search for rinks with the search field in the map.  When you click on a rink, it will automatically populate the above fields for you.
  </p>
  <%= f.button 'Submit',
               class: 'btn btn-default',
               data: { disable_with: "#{fa_icon 'spinner pulse'} Loading..." } %>
<% end %>