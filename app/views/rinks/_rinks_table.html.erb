<table class="table table-striped table-bordered table-hover card">
  <thead>
  <tr>
    <th>Name</th>
    <th width="20%">Address</th>
    <th>Latitude</th>
    <th>Longitude</th>
    <th>Actions</th>
  </tr>
  </thead>

  <tbody>
  <% @rinks.each do |rink| %>
    <tr>
      <td><%= rink.name %></td>
      <td><address><%= rink.address %></address></td>
      <td><%= rink.latitude %></td>
      <td><%= rink.longitude %></td>
      <td class="center">
        <div class="btn-group">
          <%= link_to raw('<span class="glyphicon glyphicon-eye-open"></span>'),
                      rink,
                      class: 'btn btn-sm btn-default view-rink',
                      data: { toggle: 'tooltip',
                              placement: current_user.admin? ? 'left' : 'right',
                              title: 'View rink' } %>
          <%= link_to raw('<span class="glyphicon glyphicon-edit"></span>'),
                      edit_rink_path(rink),
                      class: 'btn btn-sm btn-default edit-rink',
                      data: { toggle: 'tooltip',
                              placement: 'top',
                              title: 'Edit rink' } if current_user.admin? %>
          <%= link_to raw('<span class="glyphicon glyphicon-remove"></span>'),
                      rink,
                      method: :delete,
                      class: 'btn btn-sm btn-danger delete-rink',
                      data: { confirm: 'Are you sure?',
                              toggle: 'tooltip',
                              placement: 'right',
                              title: 'Delete rink' } if current_user.admin? %>
        </div>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>