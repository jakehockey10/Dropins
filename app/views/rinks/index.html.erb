<% provide(:title, 'Rinks') %>

<script src="//maps.google.com/maps/api/js?v=3.13&amp;sensor=false&amp;libraries=geometry,places" type="text/javascript"></script>
<script src='//google-maps-utility-library-v3.googlecode.com/svn/tags/markerclustererplus/2.0.14/src/markerclusterer_packed.js' type='text/javascript'></script>

<div class="row">
  <h2 class="center">
    Find the rink you are looking for
    <small>
      <p class="center">
        Does something not look right?  Reload the page by pressing <kbd>ctrl</kbd> + <kbd>r</kbd>.  If it still doesn't
        look right, please let me know about it <%= link_to 'here', contact_path %>.
      </p>
    </small>
  </h2>
  <% if current_user.admin? %>
    <aside class="col-sm-3 col-md-3" style="margin: 20px;">
      <section>
        <h1>Add a rink:</h1>
        <%= render 'rinks/form', rink: Rink.new %>
      </section>
      <section style="overflow: visible">
        <h1>Rinks in the system:</h1>
        <ul class="media-list" style="margin-top: 20px">
          <%= render @rinks %>
        </ul>
      </section>
    </aside>
    <div class="col-sm-9 col-md-9 thumbnail" style="margin-top: 50px; width: 810px;">
      <div style="width: 800px;">
        <input id="pac-input" class="controls" type="text" placeholder="Search Box"/>
        <div id="map" style="width: 800px; height: 400px;"></div>
      </div>
    </div>
  <% else %>
    <div class="col-sm-offset-1 col-md-offset-1 col-sm-10 col-md-10 thumbnail">
      <input id="pac-input" class="controls" type="text" placeholder="Search Box"/>
      <div id="map"></div>
    </div>
  <% end %>
</div>

<script type="text/javascript">
  var makeMap = function () {
    var handler = Gmaps.build('Google');
    handler.buildMap({ provider: {}, internal: {id: 'map'}}, function() {
      var markers = handler.addMarkers(<%= raw @hash.to_json %>);
      handler.bounds.extendWith(markers);
      handler.fitMapToBounds();
    });

    // Create the search box and link it to the UI element.
    var input = /** @type {HTMLInputElement} */(document.getElementById('pac-input'));
    var map = handler.getMap();
    map.controls[google.maps.ControlPosition.TOP_LEFT].push(input);

    var searchBox = new google.maps.places.SearchBox(/** @type {HTMLInputElement} */(input));

    // Listen for the event fired when the user selects an item from the
    // pick list.  Retrieve the matching places for that item.
    google.maps.event.addListener(searchBox, 'places_changed', function() {
      var markers = [];
      var places = searchBox.getPlaces();

      for (var i = 0, marker; marker = markers[i]; i++) {
        marker.setMap(null);
      }

      // For each place, get the icon, place name, and location.
      markers = [];
      var bounds = new google.maps.LatLngBounds();
      for (var i = 0, place; place = places[i]; i++) {
        var image = {
          url: place.icon,
          size: new google.maps.Size(71, 71),
          origin: new google.maps.Point(0, 0),
          anchor: new google.maps.Point(17, 34),
          scaledSize: new google.maps.Size(25, 25)
        };

        // Create a marker for each place.
        var marker = new google.maps.Marker({
          map: map,
          icon: image,
          title: place.name,
          position: place.geometry.location
        });

        markers.push(marker);

        bounds.extend(place.geometry.location);
      }

      map.fitBounds(bounds);

      var address = document.getElementById('rink_address');
      var name = document.getElementById('rink_name');
      address.value = places[0].formatted_address;
      name.value = places[0].name;
      if (places[0].photos) {
        var elem = document.createElement('img');
        elem.setAttribute('src', places[0].photos[0].getUrl({'maxWidth': 300, 'maxHeight': 300}));
        elem.setAttribute('class', 'thumbnail center-block img-responsive');
        elem.setAttribute('id', 'place_image');
        elem.setAttribute('style', 'margin-top: 10px;');
        document.getElementById('new_rink').appendChild(elem);
      } else {
        document.getElementById('place_image').remove();
      }
    });

    // Bias the SearchBox results towards places that are within the bounds of the
    // current map's viewport.
    google.maps.event.addListener(map, 'bounds_changed', function () {
      var bounds = map.getBounds();
      searchBox.setBounds(bounds);
    })
  };

//  google.maps.event.addDomListener(window, 'load', makeMap);
  $(document).on('ready page:load', function () {
    setTimeout(function() {
      makeMap();
    }, 1000);
  });

  var mapParent = $('#map').parent('.thumbnail');
  var width = mapParent.width();
//  var height = mapParent.height() - 8;
  $('#map').css('width', width + 'px');
  $('#map').css('height', 500 + 'px');
</script>