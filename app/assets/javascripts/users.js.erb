$(document).on('change', '.avatar_submit input:file', function () {
    var file_value = $('#avatar_file').val();
    if ( file_value.length > 0 ) {
        $('#avatar_submit_button').removeAttr('disabled');
    }
});

$(function() {
//    $('#calendar').fullCalendar({
//        events: '/dropins.json'
//    });
    initCalendar();
});

var popoverClicked = false;

function initCalendar() {
    var toSentence = function(arr) {
        return arr.join(", ").replace(/,\s([^,]+)$/, ' and $1');
    };
    $('#calendar').fullCalendar({
        header: {
            left: 'prev,next today',
            center: 'title',
            right: 'month,agendaWeek,agendaDay'
        },
        events: '/dropins.json',
        eventRender: function (event, element) {
            var list = [event.skaters.length];
            for (var i = 0; i < event.skaters.length; i++) {
                //list += '<li>' + event.skaters[i].first_name + ' ' + event.skaters[i].second_name + '</li>'
                list[i] = event.skaters[i].first_name + ' ' + event.skaters[i].second_name
            }

            element.popover({
                placement: 'auto',
                html: true,
                title: event.rink.name,
                content: '<h5><strong>Attending:</strong></h5><ul class="list-inline">' + toSentence(list) + '</ul>',
                container: 'body',
                trigger: 'focus'
            });
        },
        eventClick: function (event, jsEvent, view) {
            window.location.href = "/dropins/" + event.id;
        },
        eventMouseover: function (event, jsEvent, view) {
            if (!popoverClicked) {
                $(this).popover('show');
                popoverClicked = false;
            }
        },
        eventMouseout: function (event, jsEvent, view) {
            if (!popoverClicked) {
                $(this).popover('hide');
                popoverClicked = false;
            }
        }
    });
}